{
  "name": "flyleaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flyleaf — 个人技术工作台",
  "workspaces": [
    "core",
    "ui",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "tsx core/src/dev/server.ts",
    "dev:web": "vite",
    "dev": "node scripts/dev.mjs",
    "build:web": "vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev:desktop": "npm run build:desktop && electron apps/desktop/dist/main.cjs",
    "build:lite": "node scripts/build-lite.mjs",
    "pack:portable": "node scripts/pack-portable.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fastify/cors": "^11.3.1",
    "chokidar": "^6.0.0",
    "d3-hierarchy": "^3.1.2",
    "fastify": "^5.12.7",
    "html-to-image": "^1.11.13",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.0.0": true
  }
}
