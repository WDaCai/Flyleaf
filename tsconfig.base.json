{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "paths": {
      "@flyleaf/core": ["./core/src/index.ts"],
      "@flyleaf/core/contracts": ["./core/src/contracts.ts"],
      "@flyleaf/core/client": ["./core/src/client/index.ts"],
      "@flyleaf/ui": ["./ui/src/index.ts"]
    }
  }
}
